#. translators: %s: Codestar `database` value.
#: php/includes/Registry.php:121
#, php-format
msgid "bfields does not implement the \"%s\" database option. Keep this screen on Codestar."
msgstr "bfields no implementa la opción de base de datos «%s». Deja esta pantalla en Codestar."

#. translators: %s: Codestar `data_type` value.
#: php/includes/Registry.php:126
#, php-format
msgid "bfields does not implement data_type \"%s\" for meta boxes. Keep this screen on Codestar."
msgstr "bfields no implementa data_type «%s» para las cajas meta. Deja esta pantalla en Codestar."

#: php/includes/Sanitizer.php:206
msgid "This value is not valid."
msgstr "Este valor no es válido."

#: php/includes/Schema.php:349
msgid "A \"field_group\" holds no value: its \"default\" and \"responsive\" keys are ignored. Set them on its fields."
msgstr "Un «field_group» no guarda ningún valor: sus claves «default» y «responsive» se ignoran. Defínelas en sus campos."

#: php/includes/Schema.php:358
msgid "A \"field_group\" inside another \"field_group\" is not drawn as its own card; its fields join the outer group."
msgstr "Un «field_group» dentro de otro «field_group» no se muestra como una tarjeta propia; sus campos se unen al grupo exterior."

#: php/includes/Schema.php:364
msgid "A \"field_group\" inside a repeater row or a fieldset is not drawn as a card; its fields are shown flat."
msgstr "Un «field_group» dentro de una fila de repetidor o de un fieldset no se muestra como una tarjeta; sus campos se muestran sin agrupar."

#. translators: %s: field_group id.
#: php/includes/Schema.php:452
#, php-format
msgid "The field_group id \"%s\" is also used by a field or another group on this screen. Group ids are never stored, but they must be unique."
msgstr "El id de field_group «%s» también lo usa un campo u otro grupo de esta pantalla. Los id de grupo nunca se guardan, pero deben ser únicos."

#: php/includes/Schema.php:532
msgid "A \"field_group\" dependency and a field dependency inside it disagree on the global (4th) flag; Codestar applies one flag to both."
msgstr "La dependencia de un «field_group» y la de un campo dentro de él no coinciden en el indicador global (4.º elemento); Codestar aplica un solo indicador a ambas."

#. translators: %s: field type.
#: php/includes/Schema.php:613
#, php-format
msgid "bfields has no renderer for the field type \"%s\". Its stored value is preserved but it cannot be edited. Map it with the bfields_type_map filter."
msgstr "bfields no tiene un renderizador para el tipo de campo «%s». Su valor guardado se conserva, pero no se puede editar. Asígnalo con el filtro bfields_type_map."

#. translators: %s: field type.
#: php/includes/Schema.php:1087
#, php-format
msgid "A \"%s\" field cannot be responsive. Make its sub-fields responsive instead."
msgstr "Un campo «%s» no puede ser adaptable. Haz adaptables sus subcampos en su lugar."

#: php/includes/Storage/PostMeta.php:157
msgid "bfields only stores meta boxes with data_type \"serialize\". Nothing was saved."
msgstr "bfields solo guarda cajas meta con data_type «serialize». No se ha guardado nada."

